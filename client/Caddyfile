{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	encode gzip

	handle /api* {
		reverse_proxy {$API_URL}
	}

	handle {
		root * dist
		file_server
		try_files {path} /index.html
	}
}
