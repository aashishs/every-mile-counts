PORT=5000
NODE_ENV=development
DATABASE_URL=postgres://emc:emc@localhost:5432/every_mile_counts
JWT_SECRET=change-me-to-a-long-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CLIENT_URL=http://localhost:5173
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@everymilecounts.app

STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_REDIRECT_URI=http://localhost:5000/api/strava/callback

GARMIN_CONSUMER_KEY=your-garmin-consumer-key
GARMIN_CONSUMER_SECRET=your-garmin-consumer-secret
GARMIN_REDIRECT_URI=http://localhost:5000/api/garmin/callback

ADMIN_EMAIL=admin@everymilecounts.app
ADMIN_PASSWORD=Admin123!

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Every Mile Counts <noreply@everymilecounts.app>

# Production (Railway)
# CLIENT_URL=https://YOUR-web-service.up.railway.app
# STRAVA_REDIRECT_URI is optional (defaults to {CLIENT_URL}/api/strava/callback)
# ENCRYPTION_KEY must be 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
